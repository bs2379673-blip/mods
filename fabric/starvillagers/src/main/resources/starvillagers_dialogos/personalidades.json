  "alegre": {
    "nombre": "Alegre", "humor_base": 35, "ganas_de_saludar": 55,
    "saludo": ["¡Hola, hola, %jugador%!", "¡%jugador%! ¡Qué lindo verte!", "¡Holaaa!"],
    "saludo_amigo": ["¡%jugador%! ¡Mi persona favorita!", "¡Siii, vino %jugador%!"],
    "charla": ["¿Sabías que las flores del borde del pueblo florecen todas juntas? ¡Es lo más lindo que hay!", "¡Hoy me desperté cantando! No sé por qué.", "Me encanta este pueblo. ¡Todos son tan buenos!"],
    "charla_amigo": ["¡Cuando venís vos, el día se pone mejor!", "¡Tendríamos que hacer un picnic algún día!"],
    "saludo_aldeano": ["¡%otro%! ¡Qué alegría verte!", "¡Holaaa, %otro%!"],
    "respuesta_aldeano": ["¡Holaaa! ¡Qué lindo día!", "¡%otro%! ¡Igualmente!"],
    "le_gusta": ["#minecraft:flowers", "minecraft:cake", "minecraft:sweet_berries"]
  },
  "timido": {
    "nombre": "Tímido", "humor_base": 0, "ganas_de_saludar": 15,
    "saludo": ["H-hola...", "Ah... hola, %jugador%.", "..."],
    "saludo_amigo": ["¡Ah, %jugador%! Hola... me alegra verte.", "Hola... te estaba esperando, un poquito."],
    "charla": ["N-no soy muy bueno charlando... perdón.", "A veces miro las estrellas solo. Es tranquilo.", "Me gusta leer... cuando nadie mira."],
    "charla_amigo": ["Con vos no me da tanta vergüenza hablar.", "Gracias por tenerme paciencia, %jugador%."],
    "saludo_aldeano": ["H-hola, %otro%...", "Ah... hola, %otro%."],
    "respuesta_aldeano": ["Ah... h-hola.", "Hola... sí, bien..."],
    "regalo_encanta": ["¿P-para mí? ¿Un %item%? ...Gracias. De verdad.", "N-no tenías que... ¡pero me encanta!"],
    "le_gusta": ["minecraft:book", "minecraft:lantern", "minecraft:cookie"]
  },
  "grunon": {
    "nombre": "Gruñón", "humor_base": -20, "ganas_de_saludar": 12,
    "saludo": ["Hmpf. Hola.", "¿Qué querés?", "Ah. Vos."],
    "saludo_amigo": ["Bueno... vos sí me caés bien. Hola.", "Hola, %jugador%. No se lo digas a nadie, pero me alegra verte."],
    "charla": ["Los chicos del pueblo hacen demasiado ruido.", "En mis tiempos las cosas eran mejores.", "Otra vez llueve. Siempre llueve cuando no quiero."],
    "charla_amigo": ["Sos de los pocos que no me sacan de quicio.", "Bueno... gracias por venir. Ya está, no lo voy a repetir."],
    "saludo_aldeano": ["%otro%.", "Hmpf, %otro%."],
    "respuesta_aldeano": ["Sí, sí, hola.", "¿Qué querés, %otro%?"],
    "regalo_normal": ["Hmpf. Un %item%. ...Gracias.", "No lo necesitaba, pero bueno."],
    "le_gusta": ["minecraft:mushroom_stew", "minecraft:iron_ingot"]
  },
  "amistoso": {
    "nombre": "Amistoso", "humor_base": 20, "ganas_de_saludar": 45,
    "saludo": ["¡Hola, %jugador%! ¿Todo bien?", "¡Buenas! ¿Cómo andás?", "¡Eh, %jugador%!"],
    "saludo_amigo": ["¡%jugador%, amigo! ¿Cómo va todo?", "¡Che, %jugador%! Justo pensaba en vos."],
    "charla": ["Si necesitás algo, avisame, ¿eh?", "Ayer ayudé al herrero con unas cosas. ¡Qué buena gente!", "Siempre es lindo charlar con alguien nuevo."],
    "charla_amigo": ["Somos un buen equipo, vos y yo.", "Contá conmigo para lo que sea, %jugador%."],
    "le_gusta": ["minecraft:bread", "minecraft:cake", "minecraft:apple"]
  },
  "serio": {
    "nombre": "Serio", "humor_base": 0, "ganas_de_saludar": 25,
    "saludo": ["Buenas, %jugador%.", "Hola.", "Buen día."],
    "saludo_amigo": ["Hola, %jugador%. Es bueno verte.", "%jugador%. Llegás justo."],
    "charla": ["El trabajo bien hecho es lo más importante.", "Hay que estar preparados para lo que venga.", "Prefiero los hechos a las palabras."],
    "charla_amigo": ["Confío en vos, %jugador%. No es algo que diga seguido.", "Sos alguien de palabra. Eso se valora."],
    "regalo_encanta": ["Un %item%. Excelente elección. Gracias.", "Esto es muy útil. Te lo agradezco de verdad."],
    "le_gusta": ["minecraft:iron_ingot", "minecraft:book", "minecraft:clock"]
  },
  "coqueto": {
    "nombre": "Coqueto", "humor_base": 25, "ganas_de_saludar": 50,
    "saludo": ["¡Hola, %jugador%! Qué bien te ves hoy.", "Mirá quién vino... ¡hola!", "¡Hola, lindura!"],
    "saludo_amigo": ["¡%jugador%! Justo me estaba arreglando por si venías.", "Ay, %jugador%... siempre llegás en el momento justo."],
    "charla": ["¿Te gusta mi ropa nueva? Me la hice yo.", "Las flores me quedan bien, ¿no te parece?", "Dicen que soy lo más lindo del pueblo. Yo no digo nada..."],
    "charla_amigo": ["Con vos el tiempo se pasa volando, %jugador%.", "¿Sabés que sos de mis personas favoritas?"],
    "regalo_encanta": ["¡Ay, %jugador%! ¿Un %item% para mí? Me derrito.", "¡Sabía que te importaba!"],
    "le_gusta": ["#minecraft:flowers", "minecraft:diamond", "minecraft:gold_ingot", "minecraft:amethyst_shard"]
  },
  "chistoso": {
    "nombre": "Chistoso", "humor_base": 30, "ganas_de_saludar": 45,
    "saludo": ["¡Hola, %jugador%! ¿Sabés por qué los zombis no tienen amigos? Porque siempre llegan tarde... ¡a la vida!", "¡Eh, %jugador%! ¡Vos de nuevo! ¡Qué suerte la mía!", "¡Holiii!"],
    "saludo_amigo": ["¡%jugador%! ¡Mi público favorito!", "¡Llegó %jugador%! ¡Que empiece el show!"],
    "charla": ["¿Qué le dijo una gallina a otra? Nada, las gallinas no hablan. ¡Ja!", "Intenté hacerle cosquillas al gólem. No se rió.", "¿Viste al creeper? Siempre tan explosivo, el pobre."],
    "charla_amigo": ["Sos el único que se ríe de mis chistes, %jugador%.", "¡Vos y yo deberíamos hacer un show juntos!"],
    "saludo_aldeano": ["¡%otro%! ¿Te conté el del creeper?", "¡Eh, %otro%! ¡Tengo uno nuevo!"],
    "respuesta_aldeano": ["¡Jajaja! ¡Ay, no!", "¡No otra vez, %otro%!"],
    "le_gusta": ["minecraft:slime_ball", "minecraft:cookie", "minecraft:carved_pumpkin"]
  },
  "curioso": {
    "nombre": "Curioso", "humor_base": 15, "ganas_de_saludar": 40,
    "saludo": ["¡Hola, %jugador%! ¿De dónde venís?", "¡%jugador%! ¿Qué tenés ahí?", "¡Hola! ¿Viste algo interesante hoy?"],
    "saludo_amigo": ["¡%jugador%! ¡Contame tus aventuras!", "¡Volviste! ¿Encontraste algo nuevo?"],
    "charla": ["¿Sabías que abajo de la tierra hay cuevas enormes? Algún día quiero verlas.", "Me pregunto qué hay más allá de las montañas...", "¿Las arañas duermen? Siempre me lo pregunto."],
    "charla_amigo": ["¡Me encanta escuchar lo que hacés, %jugador%!", "Algún día llevame de aventura, ¿sí?"],
    "regalo_encanta": ["¡¿Un %item%?! ¡Fascinante! ¿De dónde lo sacaste?", "¡Wow! ¡Lo voy a estudiar toda la noche!"],
    "le_gusta": ["minecraft:compass", "minecraft:map", "minecraft:spyglass", "minecraft:amethyst_shard", "minecraft:nautilus_shell"]
  }
