// Personalidades de los aldeanos de StarVillagers (se crea sola; la podés cambiar o agregar más).
// Cada aldeano nace con una al azar. Si a una le falta un texto, usa el de "_comun".
// %jugador% = tu nombre, %npc% = el del aldeano, %otro% = el otro aldeano, %item% = lo que regalaste,
// %regalo% = el último regalo que le gustó. "humor_base" va de -100 a 100 y "ganas_de_saludar" de 0 a 100.
// "le_gusta" / "no_le_gusta": ítems ("minecraft:cake") o etiquetas ("#minecraft:flowers").
{
  "_comun": {
    "saludo": ["¡Hola, %jugador%!", "Buenas, %jugador%.", "¿Qué tal, %jugador%?"],
    "saludo_manana": ["¡Buen día, %jugador%!", "¡Buen día! ¿Dormiste bien?"],
    "saludo_tarde": ["¡Buenas tardes, %jugador%!"],
    "saludo_noche": ["Buenas noches, %jugador%...", "¡Cuidado afuera de noche!", "Ya es tarde, ¿no?"],
    "saludo_enojado": ["Ah... sos vos.", "¿Qué querés ahora?", "No me hables.", "Hmpf."],
    "saludo_reencuentro": ["¡%jugador%! ¡Hace mucho que no te veía!", "¡Volviste! Te extrañaba, %jugador%."],
    "saludo_aldeano": ["¡Hola, %otro%!", "¡Buenas, %otro%!", "¡Eh, %otro%! ¿Cómo andás?"],
    "respuesta_aldeano": ["¡Hola, %otro%!", "¡Bien! ¿Y vos, %otro%?", "¡Todo tranqui!"],
    "charla": ["Hoy fue un día tranquilo.", "¿Viste el cielo hoy? Hermoso.", "El pueblo está creciendo, ¿no?"],
    "charla_enojado": ["No tengo ganas de charlar con vos.", "Todavía me acuerdo de lo que hiciste."],
    "recuerdo_regalo": ["Todavía tengo guardado el %regalo% que me diste. ¡Gracias otra vez!", "Me acordé del %regalo% que me regalaste. Qué lindo gesto."],
    "recuerdo_golpe": ["Me sigue doliendo el golpe de la otra vez...", "La próxima no me pegues, ¿eh?"],
    "golpe": ["¡Ay! ¿Por qué?", "¡Eh! ¡Eso dolió!", "¡¿Qué te pasa?!", "¡Pará!"],

    "humor_feliz": ["¡Re bien! Hoy es un gran día.", "¡Contentísimo! No sé por qué, pero estoy feliz."],
    "humor_bien": ["Bien, por suerte. Mucho trabajo, pero me gusta.", "Bastante bien, gracias por preguntar."],
    "humor_normal": ["Normal, como siempre.", "Ahí ando. Ni bien ni mal."],
    "humor_triste": ["Un poco bajón, la verdad.", "Más o menos... no es mi mejor día."],
    "humor_enojado": ["Mal. Muy mal. Mejor no preguntes.", "Estoy de muy mal humor hoy."],

    "relacion_enemigo": ["Sinceramente... no confío en vos.", "Me hiciste daño. No me olvido fácil."],
    "relacion_desconocido": ["Todavía no te conozco mucho, la verdad.", "Te vi un par de veces por el pueblo."],
    "relacion_conocido": ["Me caés bien, %jugador%.", "Ya te voy conociendo. Sos buena onda."],
    "relacion_amigo": ["¡Sos mi amigo, %jugador%!", "Me alegra que estés por acá."],
    "relacion_buen_amigo": ["Sos de las personas que más quiero en el pueblo.", "Con vos puedo hablar de cualquier cosa."],
    "relacion_mejor_amigo": ["¡Sos mi mejor amigo, %jugador%! No sé qué haría sin vos.", "Te quiero un montón, %jugador%."],

    "regalo_nada": ["¿Mmm? No tenés nada en la mano."],
    "regalo_demasiado": ["¡Ya me diste un montón hoy! Guardalo para otro día.", "Gracias, pero ya es mucho por hoy."],
    "regalo_encanta": ["¡¿Un %item%?! ¡Me encanta! ¡Gracias, %jugador%!", "¡No puede ser! ¡Justo lo que quería!"],
    "regalo_gusta": ["¡Un %item%! Qué lindo, gracias.", "¡Ay, gracias! Me viene bárbaro."],
    "regalo_normal": ["Ah... un %item%. Gracias, supongo.", "Bueno, gracias. Lo voy a guardar."],
    "regalo_no_gusta": ["¿Un %item%? ¡Qué asco!", "Eh... no, gracias. Esto no me gusta nada."],

    "le_gusta": ["minecraft:cake", "minecraft:diamond", "minecraft:emerald", "minecraft:golden_apple", "#minecraft:flowers", "minecraft:cookie", "minecraft:pumpkin_pie"],
    "no_le_gusta": ["minecraft:rotten_flesh", "minecraft:spider_eye", "minecraft:poisonous_potato", "minecraft:bone", "minecraft:dirt"]
  },

  "_gustos_por_oficio": {
