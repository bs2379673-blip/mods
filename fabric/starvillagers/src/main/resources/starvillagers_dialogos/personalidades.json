    "charla_manana": ["¡Qué lindo amanece hoy!", "A la mañana todo tiene más energía, ¿no?", "Recién desayuné. ¿Vos ya comiste algo?"],
    "charla_tarde": ["Esta es mi hora favorita del día.", "A la tarde siempre me da un poco de sueño...", "¿Viste qué lindo está el cielo a esta hora?"],
    "charla_noche": ["De noche hay que tener cuidado afuera.", "Las estrellas se ven hermosas hoy.", "Ya debería estar en la cama... pero charlar con vos vale la pena."],
    "charla_lluvia": ["Con esta lluvia no se puede hacer nada afuera.", "Me gusta el ruido de la lluvia en el techo.", "Ojalá que no se inunde el sembrado...", "¡Estoy empapado! Bueno, un poquito."],
    "charla_humor_feliz": ["¡Hoy estoy de tan buen humor que podría bailar!", "¡Todo me sale bien hoy!"],
    "charla_humor_triste": ["Perdón si estoy medio callado... no es un buen día.", "A veces las cosas no salen como uno quiere, ¿no?"],
    "charla_humor_enojado": ["Hoy no estoy para charlas largas, ¿eh?", "Hmpf. Mejor hablemos otro día."],
    "charla_pareja": ["Te extrañé un montón, ¿sabés?", "Cuando no estás, el día se hace largo.", "¿Vamos a pasear juntos más tarde?", "Me encanta que seamos pareja, %jugador%.", "Pensé en vos toda la mañana."],
    "chisme": ["¿Sabías que %otro% anda enamorado? No le digas que te conté.", "%otro% me debe una esmeralda desde hace semanas...", "Ayer vi a %otro% hablando solo. ¿Estará bien?", "%otro% cocina riquísimo. Pedile algo, no te vas a arrepentir.", "Dicen que %otro% le tiene miedo a las arañas. ¡A las arañas!", "%otro% se levantó re temprano hoy. Algo trama."],
    "gustos": ["Me encantan estas cosas: %gustos%. Si alguna vez me traés algo así...", "Mmm... ¿lo que más me gusta? %gustos%.", "Te cuento un secreto: me vuelven loco %gustos%."],
    "charla_oficio_farmer": ["Este año la cosecha de trigo viene buenísima.", "Las zanahorias crecen mejor cerca del agua, ¿sabías?", "Si ves cuervos en el sembrado, espantalos, ¿sí?"],
    "charla_oficio_fisherman": ["Hoy saqué un salmón enorme. ¡Bueno, mediano!", "El secreto de la pesca es la paciencia... y un buen anzuelo.", "Una vez pesqué una bota. No pregunten."],
    "charla_oficio_librarian": ["Estoy leyendo un libro sobre dragones. ¡Fascinante!", "Si necesitás un encantamiento, pasá por la biblioteca.", "Los libros son ventanas a otros mundos."],
    "charla_oficio_cleric": ["Las pociones no se hacen solas, ¿eh?", "Si estás herido, tengo algo que te puede ayudar.", "La piedra luminosa es más útil de lo que la gente cree."],
    "charla_oficio_armorer": ["Una buena armadura te puede salvar la vida.", "El hierro bien templado no se dobla con nada.", "¿Viste las chispas del horno? Me encantan."],
    "charla_oficio_weaponsmith": ["Una espada bien afilada es una obra de arte.", "Nunca salgas de noche sin algo con qué defenderte.", "Estoy probando un filo nuevo. ¡Cuidado con los dedos!"],
    "charla_oficio_toolsmith": ["Un buen pico vale oro. Bueno, vale hierro.", "Las herramientas hay que cuidarlas como a un amigo.", "¿Necesitás una azada? Tengo de sobra."],
    "charla_oficio_butcher": ["Hoy hay carne fresquita, por si te interesa.", "Cocinar bien es todo un arte.", "El secreto del guiso es el tiempo."],
    "charla_oficio_cartographer": ["Estoy terminando un mapa de la zona. ¡Quedó precioso!", "¿Sabías que hay mansiones en los bosques oscuros? Las tengo marcadas.", "Una brújula y un mapa: nunca te vas a perder."],
    "charla_oficio_fletcher": ["Las flechas con plumas de gallina vuelan derechito.", "¿Probaste tirar con arco? Es relajante.", "Necesito más palos... siempre necesito más palos."],
    "charla_oficio_leatherworker": ["Este cuero va a ser una mochila hermosa.", "El cuero bien curtido dura toda la vida.", "¿Te gusta mi delantal? Lo hice yo."],
    "charla_oficio_mason": ["La piedra es como el pan: hay que saber trabajarla.", "Estoy tallando ladrillos nuevos para la plaza.", "Una casa de piedra no se cae con nada."],
    "charla_oficio_shepherd": ["Mis ovejas están re lanudas este año.", "¿Sabías que se puede teñir la lana de cualquier color?", "Contar ovejas no me da sueño. Me da trabajo."],
    "charla_oficio_nitwit": ["No tengo trabajo, pero tengo mucho tiempo para pensar.", "Hoy conté nubes. Fueron veintitrés.", "¿Para qué trabajar si se puede charlar?"],
    "charla_oficio_none": ["Todavía no sé a qué me quiero dedicar.", "Estoy buscando un trabajo. ¿Conocés algún puesto libre?", "Me gustaría ser bibliotecario... o pescador... o algo."],
