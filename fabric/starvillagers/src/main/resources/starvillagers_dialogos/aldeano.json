// Charla de los aldeanos de StarVillagers (se crea sola; la podés cambiar).
// Marcadores: %saludo% %charla% %humor% %relacion% %reaccion% %personalidad% (salen de
// config/starvillagers/personalidades.json), %npc% y %jugador%.
// Acciones: "comerciar", "charlar" (suma amistad una vez por día), "regalar" (le da lo que tenés en la mano),
// "amistad:5", "humor:10". "animacion" puede usar %anim_saludo% %anim_charla% %anim_humor% %anim_relacion%.
// "juntos:chocar|abrazar|mano|besar" (necesitan 20/40/60/80 de amistad; la mano se suelta agachándote).
// Condiciones: "amistad:>=40", "humor:<0", "personalidad:timido", "en_mano".
{
  "inicio": "hola",
  "nodos": {
    "hola": {
      "texto": ["%saludo%"],
      "animacion": "%anim_saludo%",
      "opciones": [
        {"texto": "Charlemos un rato", "ir": "charla"},
        {"texto": "Te traje algo", "si": ["en_mano"], "ir": "regalo"},
        {"texto": "¿Cómo andás?", "ir": "estado"},
        {"texto": "¿Qué tenés para cambiar?", "si": ["amistad:>=0"], "acciones": ["comerciar"]},
        {"texto": "¿Qué pensás de mí?", "ir": "relacion"},
        {"texto": "Hagamos algo juntos", "si": ["amistad:>=20"], "ir": "juntos"},
        {"texto": "Contame algo del pueblo", "si": ["amistad:>=0"], "ir": "pueblo"},
        {"texto": "Perdón por lo de antes...", "si": ["amistad:<0"], "ir": "perdon"},
        {"texto": "Nada, ¡chau!", "acciones": ["animar:wave"]}
      ]
    },
    "charla": {
      "texto": ["%charla%"],
      "animacion": "%anim_charla%",
      "acciones": ["charlar"],
      "opciones": [
        {"texto": "Contame más", "ir": "charla"},
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Bueno, nos vemos", "acciones": ["animar:wave"]}
      ]
    },
    "regalo": {
      "acciones": ["regalar"],
      "texto": ["%reaccion%"],
      "animacion": "",
      "opciones": [
        {"texto": "De nada", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "estado": {
      "texto": ["%humor%"],
      "animacion": "%anim_humor%",
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Bueno, nos vemos", "acciones": ["animar:wave"]}
      ]
    },
    "relacion": {
      "texto": ["%relacion%"],
      "animacion": "%anim_relacion%",
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "juntos": {
      "texto": ["¿Qué tenés ganas de hacer?", "¡Dale! ¿Qué hacemos?"],
      "opciones": [
        {"texto": "¡Chocá esos cinco!", "acciones": ["juntos:chocar"]},
        {"texto": "¿Un abrazo?", "si": ["amistad:>=40"], "acciones": ["juntos:abrazar"]},
        {"texto": "¿Me das la mano? Vamos a pasear", "si": ["amistad:>=60"], "acciones": ["juntos:mano"]},
        {"texto": "Un beso...", "si": ["amistad:>=80"], "acciones": ["juntos:besar"]},
        {"texto": "Volver", "ir": "hola"}
      ]
    },
    "perdon": {
      "texto": ["Hmm... bueno. Voy a pensarlo.", "No es tan fácil... pero gracias por decirlo."],
      "animacion": "think",
      "acciones": ["charlar"],
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "pueblo": {
      "texto": [
        "Dicen que de noche andan zombis por las afueras. Yo no salgo.",
        "El herrero tiene las mejores herramientas, pero cobra caro.",
        "Hace poco llegó gente nueva al pueblo. Se ven simpáticos.",
        "Si ves un gólem de hierro, saludalo. Nos cuida a todos."
      ],
      "opciones": [
        {"texto": "Interesante", "ir": "hola"},
        {"texto": "Gracias, chau", "acciones": ["animar:wave"]}
      ]
    }
  }
}
