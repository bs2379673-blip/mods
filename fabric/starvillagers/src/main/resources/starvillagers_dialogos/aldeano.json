// Charla de los aldeanos de StarVillagers (se crea sola; la podés cambiar).
// Marcadores: %saludo% %charla% %humor% %relacion% %reaccion% %personalidad% (salen de
// config/starvillagers/personalidades.json), %npc% y %jugador%.
// Acciones: "comerciar", "charlar" (suma amistad una vez por día), "regalar" (le da lo que tenés en la mano),
// "amistad:5", "humor:10". "animacion" puede usar %anim_saludo% %anim_charla% %anim_humor% %anim_relacion%.
// "juntos:chocar|acariciar|sentarse|abrazar|mano|cargar|que_me_cargue|besar" (piden 20/30/30/40/60/60/70/80 de amistad;
// la mano, cargar y sentarse se terminan agachándote; de upa te bajás como de cualquier montura).
// "familia:noviazgo|casamiento|hijo|terminar|arbol" (casarse pide el Anillo de compromiso en la mano: diamante arriba y 5 de oro).
// "vestir" abre la biblioteca de skins de MCA para cambiarle ropa o pelo (admins, creativo o su esposo/a).
// "pedido:pedir|entregar" (pedidos chicos, uno por día). "juntos:peli" se sientan a mirar una pantalla de StarFrames.
// Condiciones: "pedido_libre", "pedido_listo", "pedido_activo", "puede_vestir", "pareja", "novios", "casados", "libre", "tiene_anillo", "puede_tener_hijo", "amistad:>=40", "humor:<0", "personalidad:timido", "en_mano".
{
  "inicio": "hola",
  "nodos": {
    "hola": {
      "texto": ["%saludo%"],
      "animacion": "%anim_saludo%",
      "opciones": [
        {"texto": "Charlemos un rato", "ir": "charla"},
        {"texto": "Te traje algo (lo que tengo en la mano)", "ir": "regalo"},
        {"texto": "¿Necesitás algo?", "si": ["pedido_libre"], "ir": "pedido"},
        {"texto": "¡Te traje lo que pediste!", "si": ["pedido_listo"], "ir": "pedido_ok"},
        {"texto": "¿Qué tenés para cambiar?", "si": ["amistad:>=0"], "acciones": ["comerciar"]},
        {"texto": "Hablemos de nosotros...", "ir": "nosotros"},
        {"texto": "Hagamos algo juntos", "si": ["amistad:>=20"], "ir": "juntos"},
        {"texto": "Perdón por lo de antes...", "si": ["amistad:<0"], "ir": "perdon"},
        {"texto": "Nada, ¡chau!", "acciones": ["animar:wave"]}
      ]
    },
    "charla": {
      "texto": ["%charla%"],
      "animacion": "%anim_charla%",
      "acciones": ["charlar"],
      "opciones": [
        {"texto": "Contame más", "ir": "charla"},
        {"texto": "¿Cómo andás?", "ir": "estado"},
        {"texto": "¿Qué cosas te gustan?", "ir": "gustos"},
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Bueno, nos vemos", "acciones": ["animar:wave"]}
      ]
    },
    "regalo": {
      "acciones": ["regalar"],
      "texto": ["%reaccion%"],
      "animacion": "",
      "opciones": [
        {"texto": "De nada", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "pedido": {
      "acciones": ["pedido:pedir"],
      "texto": ["%reaccion%"],
      "opciones": [
        {"texto": "¡Dale, te lo consigo!", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "pedido_ok": {
      "acciones": ["pedido:entregar"],
      "texto": ["%reaccion%"],
      "animacion": "",
      "opciones": [
        {"texto": "¡De nada!", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "gustos": {
      "texto": ["%gustos%"],
      "opciones": [
        {"texto": "¡Lo tengo en cuenta!", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "progreso": {
      "texto": ["%progreso%"],
      "animacion": "think",
      "opciones": [
        {"texto": "Volver", "ir": "nosotros"}
      ]
    },
    "estado": {
      "texto": ["%humor%"],
      "animacion": "%anim_humor%",
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Bueno, nos vemos", "acciones": ["animar:wave"]}
      ]
    },
    "relacion": {
      "texto": ["%relacion%"],
      "animacion": "%anim_relacion%",
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "juntos": {
      "texto": ["¿Qué tenés ganas de hacer?", "¡Dale! ¿Qué hacemos?"],
      "opciones": [
        {"texto": "¡Chocá esos cinco!", "acciones": ["juntos:chocar"]},
        {"texto": "*Le acariciás la cabeza*", "si": ["amistad:>=30"], "acciones": ["juntos:acariciar"]},
        {"texto": "Sentémonos un rato", "si": ["amistad:>=30"], "acciones": ["juntos:sentarse"]},
        {"texto": "Miremos una peli (pantalla cerca)", "si": ["amistad:>=30"], "acciones": ["juntos:peli"]},
        {"texto": "¿Un abrazo?", "si": ["amistad:>=40"], "acciones": ["juntos:abrazar"]},
        {"texto": "Más cosas...", "si": ["amistad:>=60"], "ir": "juntos2"},
        {"texto": "Volver", "ir": "hola"}
      ]
    },
    "juntos2": {
      "texto": ["¿Algo más especial?", "Mmm... ¿qué se te ocurre?"],
      "opciones": [
        {"texto": "¿Me das la mano? Vamos a pasear", "si": ["amistad:>=60"], "acciones": ["juntos:mano"]},
        {"texto": "¡Te cargo!", "si": ["amistad:>=60"], "acciones": ["juntos:cargar"]},
        {"texto": "¿Me llevás a upa?", "si": ["amistad:>=70"], "acciones": ["juntos:que_me_cargue"]},
        {"texto": "Un beso...", "si": ["amistad:>=80"], "acciones": ["juntos:besar"]},
        {"texto": "Volver", "ir": "juntos"}
      ]
    },
    "nosotros": {
      "texto": ["¿Sí? ¿Qué pasa?", "Te escucho."],
      "opciones": [
        {"texto": "¿Qué pensás de mí?", "ir": "relacion"},
        {"texto": "¿Cómo vamos? (amistad)", "ir": "progreso"},
        {"texto": "¿Querés salir conmigo?", "si": ["libre", "amistad:>=80"], "acciones": ["familia:noviazgo"]},
        {"texto": "¿Te querés casar conmigo?", "si": ["novios", "tiene_anillo"], "acciones": ["familia:casamiento"]},
        {"texto": "¿Y si tenemos un bebé?", "si": ["puede_tener_hijo"], "acciones": ["familia:hijo"]},
        {"texto": "Contame de tu familia", "acciones": ["familia:arbol"]},
        {"texto": "¿Te cambio la ropa o el pelo?", "si": ["puede_vestir"], "acciones": ["vestir"]},
        {"texto": "Creo que deberíamos terminar...", "si": ["pareja"], "ir": "terminar"},
        {"texto": "Volver", "ir": "hola"}
      ]
    },
    "terminar": {
      "texto": ["¿Q-qué...? ¿Lo decís en serio?", "Esperá... ¿qué?"],
      "animacion": "sad",
      "opciones": [
        {"texto": "Sí... perdón", "acciones": ["familia:terminar"]},
        {"texto": "No, no, olvidate", "ir": "hola"}
      ]
    },
    "perdon": {
      "texto": ["Hmm... bueno. Voy a pensarlo.", "No es tan fácil... pero gracias por decirlo."],
      "animacion": "think",
      "acciones": ["charlar"],
      "opciones": [
        {"texto": "Volver", "ir": "hola"},
        {"texto": "Chau", "acciones": ["animar:wave"]}
      ]
    },
    "pueblo": {
      "texto": [
        "Dicen que de noche andan zombis por las afueras. Yo no salgo.",
        "El herrero tiene las mejores herramientas, pero cobra caro.",
        "Hace poco llegó gente nueva al pueblo. Se ven simpáticos.",
        "Si ves un gólem de hierro, saludalo. Nos cuida a todos."
      ],
      "opciones": [
        {"texto": "Interesante", "ir": "hola"},
        {"texto": "Gracias, chau", "acciones": ["animar:wave"]}
      ]
    }
  }
}
