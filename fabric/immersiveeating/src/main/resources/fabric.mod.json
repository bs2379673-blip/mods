  "authors": ["XianYue", "NightEpiphany"],
  "contributors": ["Port 1.21.11: Starlevi"],
  "contact": {
    "sources": "https://github.com/MemoryToame/ImmersiveEating",
    "issues": "https://github.com/MemoryToame/ImmersiveEating/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/food/pack.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.memorytoame.immersiveeating.fabric.KaleidoscopeImmersiveEating"],
